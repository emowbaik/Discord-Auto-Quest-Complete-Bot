TOKENS=discord_token_1
discord_token_2
NOPECHA_API_KEY=your_nopecha_api_key
# For multiple keys (round-robin, fallback on rate-limit): comma or newline separated
# NOPECHA_API_KEY=key1,key2
# NOPECHA_API_KEY=key1
# key2
NONECAP_API_KEY=nc_live_your_key_here
# NONECAP_API_KEY=nc_live_key1,nc_live_key2
# NONECAP_API_KEY=nc_live_key1
# nc_live_key2
# NONECAP_PROXY=http://user:pass@host:port
# For per-key proxies (matched by order): comma or newline separated
# NONECAP_PROXY=proxy_for_key1,proxy_for_key2
# NONECAP_WAIT=45
TG_BOT_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_telegram_chat_id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
