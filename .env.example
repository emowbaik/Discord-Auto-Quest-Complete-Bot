TOKENS=discord_token_1
discord_token_2
OPENAI_BASE_URL=https://your-openai-compatible-endpoint.com
OPENAI_API_KEY=your_api_key
OPENAI_MODEL=your_vision_model_name
# Browser claim — uses Vision API to solve hCaptcha challenge images
# BROWSER_CLAIM=true
# BROWSER_HEADLESS=false
# Extension path (NoneCap): download from Chrome Web Store, set path to unpacked extension folder
# BROWSER_EXTENSION_PATH=C:\path\to\nonecap-extension
TG_BOT_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_telegram_chat_id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
